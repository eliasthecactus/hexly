{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexly",
  "identifier": "ch.benavo.hexly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hexly",
        "width": 1320,
        "height": 840,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "© 2026 Elias Frehner",
    "publisher": "Elias Frehner",
    "homepage": "https://github.com/eliasthecactus/hexly",
    "shortDescription": "A fast hex editor for binaries",
    "longDescription": "Hexly is a fast, cross-platform hex editor built for working with binaries: huge files, ELF/PE/Mach-O structure, disassembly, pattern search, compare and safe patching.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["bin", "rom", "elf"],
        "name": "Binary file",
        "description": "Binary file",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2OUNBQTZGRkQyREJGNzgKUldSNHZ5MzliNnFjaG1yVDdHVGhmWHU1UWZhTkJudEgrQWkzMi9YcXFuMUZMd2FlZVBaWmFITWYK",
      "endpoints": [
        "https://github.com/eliasthecactus/hexly/releases/latest/download/latest.json"
      ]
    }
  }
}
